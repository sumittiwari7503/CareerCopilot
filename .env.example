# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careercopilot?schema=public"

# SUPABASE_URL: The API URL for your Supabase project (Server-side).
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Client-side public key (Server-side).
SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE_JWT_SECRET: Shared secret key used to verify user login JWT tokens on the backend.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# SUPABASE_SERVICE_ROLE_KEY: Backend bypass key. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==========================================
# Client-side configuration (prefix with VITE_)
# ==========================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
